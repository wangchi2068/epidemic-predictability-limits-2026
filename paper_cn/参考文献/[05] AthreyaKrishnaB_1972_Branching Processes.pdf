<meta name="DC.Title" content="Encoding neuronal shape in the stochastic dynamics of branching processes" />
<meta name="DC.Identifier" content="10.64898/2026.06.05.729577" />
<meta name="DC.Date" content="2026-06-05" />
<meta name="DC.Publisher" content="Cold Spring Harbor Laboratory" />
