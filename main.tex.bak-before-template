\subsection{时变传播扰动与宏观聚合方差累积律}

\begin{proposition}[宏观固定离散度更新模型的领先阶方差累积律]\label{thm:t5}
在逐代独立更新的宏观负二项聚合模型下，设条件发病规模满足 $Z_t \mid \mathcal{F}_{t-1} \sim \text{NB}(\mu_t = R_t Z_{t-1}, k_{\text{agg}})$，其条件相对方差满足 $\text{Var}(Z_t \mid \mathcal{F}_{t-1})/\mu_t^2 = 1/\mu_t + 1/k_{\text{agg}}$。发病对数满足逐代更新方程 $\log Z_t = \log Z_{t-1} + \log R_t + b_t + \xi_t$，其中 $b_t = \mathbb{E}[\log Z_t \mid \mathcal{F}_{t-1}] - \log(R_t Z_{t-1})$ 为 Jensen 修正项（因 $\mathbb{E}[\log Z_t] \neq \log \mathbb{E}[Z_t]$ 而一般非零），$\xi_t$ 为中心化后的创新；在大计数、一阶 Delta 近似下 $b_t$ 及其波动为高阶项，本文忽略之、结果按领先阶理解，其中 $\xi_t$ 描述由宏观过度离散引起的逐代传播抽样涨落（参数 $k_{\text{agg}}$ 刻画宏观聚合序列的时序离散度，在概念上独立于微观个体离散度 $k$）。若对数再生数叠加独立同分布环境扰动 $\log R_t = \log R + \eta_t$（$\eta_t \sim \mathcal{N}(0, v^2)$），在条件于未灭绝事件（$Z_h > 0$）且各步发病规模充分大（$\min_{1 \le t \le h} \mu_t \gg k_{\text{agg}}$）的前提下，对数前瞻预测方差呈线性累积：
\begin{equation}
\text{Var}(\log Z_h \mid Z_h > 0) \sim h \left(v^2 + \frac{1}{k_{\text{agg}}}\right).
\end{equation}
\end{proposition}

\begin{proof}
\textbf{证明概要与机理阐释：}设环境扰动序列 $\{\eta_t\}$ 与抽样涨落序列 $\{\xi_t\}$ 相互独立且各自跨代独立（本证明的显式前提）。将对数递推累加，由于更新创新项满足正交鞅差性质，逐代噪声互不相关。在 $\mathbb{E}[Z_h]\gg 1$ 的大样本体制下，条件于未灭绝事件 $\{Z_h>0\}$ 与无条件分布在领先阶重合：由有限初值 $I_0$ 出发，超临界过程的全灭绝概率收敛于 $q^{I_0}>0$（$q<1$ 为单株终极灭绝概率），并非随 $h$ 几何衰减；本文的处理是对 $I_0$ 充分大、$q^{I_0}$ 因而可忽略的大初值近似，此时按无条件矩计算与条件矩渐近等价。宏观大样本发病下泊松抽样方差 $1/\mathbb{E}[Z_t] \to 0$，单代方差饱和于 $1/k$。独立累加后即证方差线性扩张。（详细展开见附录 E。）
\end{proof}

作为命题~\ref{thm:t5} 环境噪声分量在时间自相关情形下的平行扩展，定理 5R 刻画传播增长率存在时间自相关（平稳 AR(1) 持续性漂移）时的对数增长率累积方差规律。须强调二者对象与组成不同：命题~\ref{thm:t5} 针对 $\log Z_h$ 的方差、线性系数 $v^2 + 1/k_{\text{agg}}$ 同时含环境噪声与负二项抽样地板；定理 5R 仅针对对数增长率之和 $\sum_{j=1}^h r_{t+j} = \log(Z_{t+h}/Z_t)$ 的环境漂移部分，其闭式不含 $1/k_{\text{agg}}$ 项——故 $\phi=0$ 时定理 5R 退化为 $s_e^2 h$ 而非命题~\ref{thm:t5} 的 $h(v^2+1/k_{\text{agg}})$，它是 $r_t$ 子过程的自相关版本而非命题~\ref{thm:t5} 的严格推广；若要含抽样地板的完整前瞻方差，需在两序列独立假设下将定理 5R 与 $h/k_{\text{agg}}$ 项相加。

\begin{theorem5R}\label{thm:t5r}
当对数增长率 $r_t = \log R_t$ 服从具有持久性自相关系数 $|\phi| < 1$ 与创新方差 $s_e^2$ 的平稳 AR(1) 过程时，未来 $h$ 步对数增长率之和 $\sum_{j=1}^h r_{t+j}$（即 $\log(Z_{t+h}/Z_t)$ 的环境漂移部分）的无条件方差满足精确闭式解：
\begin{equation}
\text{Var}\left(\sum_{j=1}^h r_{t+j}\right) = \gamma_0 \left[ h + 2 \sum_{\ell=1}^{h-1} (h-\ell) \phi^\ell \right] \sim \gamma_0 h \frac{1+\phi}{1-\phi} \quad (h \to \infty),
\end{equation}
其中 $\gamma_0 = s_e^2/(1-\phi^2)$ 为平稳无条件方差。若系统跃迁至非平稳单位根随机游走极限（$\phi = 1$），则长周期无条件方差发散，条件于当期状态 $r_t$ 的累积前瞻方差需单独按纯随机游走积分计算：
\begin{equation}
\text{Var}\left(\sum_{j=1}^h r_{t+j} \;\middle|\; r_t\right) = s_e^2 \sum_{j=1}^h j^2 = \frac{s_e^2 h(h+1)(2h+1)}{6} \sim \frac{s_e^2 h^3}{3} \quad (h \to \infty),
\end{equation}
呈现三次方超线性发散特征，导致中远期预测视界发生深度坍塌。

须注意：平稳分支给出的是无条件方差（前瞻条件方差更小）；且本定理仅刻画环境漂移，不含宏观抽样地板 $h/k_{\text{agg}}$（推论~\ref{cor:pop_floor}）。两者在独立假定下相加。
\end{theorem5R}

\begin{proof}[证明要点]
平稳自回归自协方差双重求和利用等比级数导出大步长渐近线性律；单位根极限下未来增量为加权创新和 $\sum_{m=1}^h (h-m+1)e_{t+m}$，平方和通项直接给出立方级发散 $\sim s_e^2 h^3/3$。
\end{proof}

\begin{corollary}[固定时间聚合尺度下的 $h/k_{\text{agg}}$ 方差累积律]\label{cor:pop_floor}
对于跨种群聚合的宏观更新模型，当各步平均发病规模充分大（$\min_{1 \le t \le h} \mu_t \gg k_{\text{agg}}$）时，记 $Z_h^{\text{agg}}$ 为第 $h$ 步宏观观测发病水平，其对数方差满足固定时间聚合尺度下的一阶渐近累积律：
\begin{equation}
\text{Var}(\log Z_h^{\text{agg}}) \sim \frac{h}{k_{\text{agg}}},
\label{eq:pop_floor}
\end{equation}
该累积律的首项系数与绝对发病规模 $\mu$ 渐近解耦：$1/k_{\text{agg}}$ 是大样本宏观聚合更新序列中由宏观离散度决定、在跨代独立增量假设下的渐近噪声累积速率（在一阶 Delta 近似意义下，非严格逐点不等式界）。
\end{corollary}

\begin{proof}
\textbf{证明概要与机理阐释：}对单代估计量 $\hat{I}$ 一阶 Delta 展开给 $\text{Var}(\log\hat{I}) \approx 1/\mu + 1/k_{\text{agg}}$。对 $h$ 代累计量 $\tilde{I}_h$，其对数即命题~\ref{thm:t5} 的逐代对数增量之和 $\log\tilde{I}_h = \log \tilde{I}_0 + \sum_{t=1}^{h}(\eta_t + \xi_t)$；在命题~\ref{thm:t5} 的跨代独立假设下各代抽样涨落方差 $\text{Var}(\xi_t)\approx 1/k_{\text{agg}}$ 线性相加（此处为 $\sim$ 意义的一阶渐近累积而非逐点不等式界，delta 展开余项符号未控），且 $\mu \gg k$ 时泊松项 $1/\mathbb{E}[Z_t] \to 0$ 被抹平，故 $\text{Var}(\log\tilde{I}_h) \sim h/k$，即式 (\ref{eq:pop_floor})。（详细推导见附录 E。）
\end{proof}

\label{sec:macro_model}

\noindent\textbf{模型内条件方差的适用声明。}须先澄清本定理的对象：定理~\ref{thm:sharp_floor} 中的 $V_h$ 指\emph{真实}条件方差，而其具体解析闭式只在明确条件下可写——即 $Z_0=I_0$ 确定已知、$R$ 与 $k_{\text{agg}}$ 取固定已知值、$\mathcal{F}_t$ 中不含额外未建模状态不确定性、且未来无外生扰动。因此本节的有限步方差是\textbf{条件于固定 $(Z_0,R,k_{\text{agg}})$ 的模型内过程方差}，并不等同于包含参数后验与状态估计不确定性的完整条件方差；后者的分解由命题~\ref{prop:posterior_mixture} 单独给出。据此，全文对实证读数统一表述为“在固定 $k_{\text{agg}}$ 插件估计条件下的宏观条件精确机制视界”，以避免把公式的代数精确性误读为参数估计的精确性。

\begin{theorem}[固定离散度宏观负二项更新模型的精确有限步方差闭式]\label{thm:macro_exact}
在逐代独立更新的宏观负二项聚合模型下，设周度发病序列满足 $Z_t \mid \mathcal{F}_{t-1} \sim \text{NB}(R Z_{t-1}, k_{\text{agg}})$，初始发病水平给定为 $Z_0 = I_0$，增长乘子 $R > 0$。记 $m_t = \mathbb{E}[Z_t \mid Z_0] = I_0 R^t$，$V_t = \text{Var}(Z_t \mid Z_0)$，初始条件 $V_0 = 0$。则条件方差满足严格一阶差分递推方程：
\begin{equation}
V_{t+1} = q V_t + I_0 R^{t+1} + \frac{I_0^2 R^{2t+2}}{k_{\text{agg}}}, \qquad q \equiv R^2 \left(1 + \frac{1}{k_{\text{agg}}}\right) = c R^2, \quad c \equiv 1 + \frac{1}{k_{\text{agg}}}. \label{eq:macro_var_recurrence}
\end{equation}
对于任意整数提前期 $h \ge 1$，该非齐次差分方程具有严格解析闭式解：
\begin{equation}
V_h = I_0 R\, \frac{q^h - R^h}{q - R} + I_0^2 \left(q^h - R^{2h}\right), \label{eq:macro_var_closed}
\end{equation}
其相对均方误差（变异系数平方 $\text{CV}^2_{\text{macro}}(h)$）严格为：
\begin{equation}
\text{CV}^2_{\text{macro}}(h) \equiv \frac{V_h}{(I_0 R^h)^2} = \frac{R}{I_0}\cdot\frac{q^h - R^h}{R^{2h}(q - R)} + \left[\left(1 + \frac{1}{k_{\text{agg}}}\right)^{\!h} - 1\right]. \label{eq:macro_cv2_closed}
\end{equation}
\end{theorem}

\begin{proof}
\textbf{证明概要与机理阐释：}对宏观更新单步矩应用全方差法则，得到式 (\ref{eq:macro_var_recurrence}) 的一阶非齐次差分方程。以因子 $q^{-(t+1)}$ 裂项累加求和，两项等比数列和分别为 $R(q^h-R^h)/(q-R)$ 与 $R^2(q^h-R^{2h})/(q-R^2)$；利用恒等式 $q - R^2 = R^2/k_{\text{agg}}$ 合并即得式 (\ref{eq:macro_var_closed}) 与式 (\ref{eq:macro_cv2_closed})。详细完整代数推导见附录 E。
\end{proof}

\begin{lemma}[数值稳定边界极限与渐近收敛性]\label{lem:macro_boundaries}
定理~\ref{thm:macro_exact} 的闭式解在临界参数边界处满足以下连续延拓与渐近极限：
\begin{enumerate}
\item \textbf{重合增长边界 ($q \to R$)}：当 $R(1 + 1/k_{\text{agg}}) \to 1$ 时，差商项连续收敛为 $\lim_{q\to R} \frac{q^h - R^h}{q - R} = h R^{h-1}$，数值实现时切换为：
\begin{equation}
V_h \Big|_{q=R} = I_0 h R^h + I_0^2 R^h \bigl(1 - R^h\bigr), \label{eq:bound_q_eq_R}
\end{equation}
完全避免了 $0/0$ 型浮点相消误差。
\item \textbf{近临界无增长边界 ($R \to 1$)}：当 $R = 1$ 时，$q = 1 + 1/k_{\text{agg}} = c$，$q - R = 1/k_{\text{agg}}$，方差解析式严格退化为：
\begin{align}
V_h \Big|_{R=1} &= I_0 (k_{\text{agg}} + I_0) \left[ \left(1 + \frac{1}{k_{\text{agg}}}\right)^h - 1 \right], \label{eq:bound_R_eq_1} \\
\text{CV}^2_{\text{macro}}(h) \Big|_{R=1} &= \left(1 + \frac{k_{\text{agg}}}{I_0}\right) \left[ \left(1 + \frac{1}{k_{\text{agg}}}\right)^h - 1 \right]. \label{eq:bound_R_eq_1_cv}
\end{align}
\item \textbf{宏观泊松极限 ($k_{\text{agg}} \to \infty$)}：当过度离散消失时，$c \to 1$，$q \to R^2$，二次项消失，方差平滑退化为经典纯泊松分支方差：
\begin{equation}
\lim_{k_{\text{agg}}\to\infty} V_h = I_0 R \frac{R^{2h} - R^h}{R^2 - R} = I_0 R^h \frac{R^h - 1}{R - 1}.
\end{equation}
\item \textbf{大初值渐近饱和极限 ($I_0 \to \infty$)}：当暴发规模极大时，线性人口项衰减为零，相对方差严格收敛至由宏观离散度决定的不可约地板：
\begin{equation}
\lim_{I_0 \to \infty} \text{CV}^2_{\text{macro}}(h) = \left(1 + \frac{1}{k_{\text{agg}}}\right)^h - 1 \sim \frac{h}{k_{\text{agg}}} \quad (h/k_{\text{agg}} \ll 1).
\end{equation}
\end{enumerate}
\end{lemma}

\begin{proof}
\textbf{证明概要与机理阐释：}性质 1 的差商极限由 L'H\^opital 法则对连续变量 $q$ 求导直接给出：$\lim_{q\to R} (q^h-R^h)/(q-R) = h R^{h-1}$；性质 2 在 $R=1$ 时 $q-R = 1/k_{\text{agg}}$，代入式 (\ref{eq:macro_var_closed}) 因式分解即得式 (\ref{eq:bound_R_eq_1}) 与 (\ref{eq:bound_R_eq_1_cv})；性质 3 在 $k_{\text{agg}}\to\infty$ 时二次项系数为零，退化为经典纯泊松分支方差；性质 4 在 $I_0\to\infty$ 时线性人口项除以 $I_0^2$ 趋于零，仅余与 $I_0$ 解耦的宏观离散度几何主项。
\end{proof}

\begin{proposition}[共享对数正态增长率的参数后验混合]\label{prop:posterior_mixture}
若增长率后验服从对数正态分布 $R = \exp(B)$（$B \sim \mathcal{N}(\mu_B, \sigma_B^2)$），矩母为 $M_a = \mathbb{E}[R^a] = \exp(a\mu_B + a^2\sigma_B^2/2)$。应用全方差法则，预测目标 $Z_h$ 的全条件方差分解为过程方差与参数推断方差：
\begin{equation}
\operatorname{Var}(Z_h \mid \mathcal{F}_t) = \mathbb{E}_R[V_h(R)] + \operatorname{Var}_R(I_0 R^h) = I_0 \sum_{j=1}^h c^{h-j} M_{2h-j} + I_0^2 M_{2h}(c^h - 1) + I_0^2(M_{2h} - M_h^2). \label{eq:mixture_full_var}
\end{equation}
若采用后验中位数 plug-in 预测器 $\delta_h^{\text{plug}} = I_0 e^{h\mu_B}$，其超额平方风险为 $\Delta \mathcal{R}_h = I_0^2 e^{2h\mu_B}(e^{h^2\sigma_B^2/2} - 1)^2$。
\end{proposition}

\begin{proof}
\textbf{证明概要与机理阐释：}参数方差项由对数正态对偶阶矩恒等式直接给出：$\operatorname{Var}_R(I_0 R^h) = I_0^2(\mathbb{E}[R^{2h}] - (\mathbb{E}[R^h])^2) = I_0^2(M_{2h} - M_h^2)$。对于平均过程方差项，将有限步展开式 $V_h(R) = I_0 \sum_{j=1}^h c^{h-j} R^{2h-j} + I_0^2 R^{2h}(c^h - 1)$ 两端关于 $R$ 取后验期望，利用期望线性性质及 $\mathbb{E}[R^{2h-j}] = M_{2h-j}$、$\mathbb{E}[R^{2h}] = M_{2h}$，即得有限和式 (\ref{eq:mixture_full_var})。中位数 plug-in 规则的超额风险由定理~\ref{thm:sharp_floor} 式 (\ref{eq:sharp_floor_excess}) 给出，代入 $(\bar{m}_h - \delta_h^{\text{plug}})^2 = I_0^2(M_h - e^{h\mu_B})^2$ 展开即证。
\end{proof}

\noindent\textbf{频率学派插件近似主口径与贝叶斯后验扩展的区分声明：}必须在理论层面严格厘清两套概率对象的边界：
\begin{enumerate}
\item \textbf{频率学派插件近似主口径（本文州级实证主线）}：引理~\ref{lem:param_amplification} 假设在固定真实参数 $b = \log R$ 下，极大似然或对数线性回归估计量在重复抽样中满足 $\hat{b} \sim \mathcal{N}(b, s^2)$。此时相对均方误差主方程为 $\text{CV}^2_{\text{macro}}(h; \hat{R}, k_{\text{agg}}, I_0) + P(h; s) \le \tau^2$，其归一化分母为条件均值基准 $(I_0 R^h)^2$。本文第 4 节全部州级面板机制视界（表~\ref{tab:horizons}、表~\ref{tab:caliber}、表~\ref{tab:scenarios}、表~\ref{tab:rolling}）均严格以此频率学派插件近似风险为唯一主口径。
\item \textbf{贝叶斯后验预测扩展（命题~\ref{prop:posterior_mixture}）}：讨论的是在给定历史信息集 $\mathcal{F}_t$ 后，未知参数后验分布为 $B \mid \mathcal{F}_t \sim \mathcal{N}(\mu_B, \sigma_B^2)$ 时的完全贝叶斯预测风险。在此框架下，中位数插件预测器 $\delta_h^{\text{plug}} = I_0 e^{h\mu_B}$ 的完全条件平方风险为 $\mathcal{R}_h(\delta_h^{\text{plug}} \mid \mathcal{F}_t) = \mathbb{E}_R[V_h(R)] + I_0^2(M_{2h} - M_h^2) + I_0^2(M_h - e^{h\mu_B})^2$，其严格归一化分母应为后验混合均值平方 $\bar{m}_h^2 = (I_0 M_h)^2$。此后验混合风险在代数上一般不等于插件近似式 $\text{CV}^2_{\text{macro}} + P(h)$。因现实周度监测面板在无强先验主观假定下无法严格识别连续后验分布 $\pi(\Theta \mid \mathcal{F}_t)$，命题~\ref{prop:posterior_mixture} 作为独立的后验解析扩展呈现，实证求根统一保留频率学派插件近似风险，不再将其混称为“后验全方差方程”。
\end{enumerate}

